# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. See DECISIONS.md D003 for provisioning options.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tangent_smart_manager?schema=public"

# AES-256-GCM key for encrypting secrets at rest (e.g. MFA TOTP secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_MFA_CHALLENGE_EXPIRES_IN=5m

# Comma-separated list of allowed origins for the Flutter web client.
CORS_ORIGIN=http://localhost:5173

# Folder for encrypted uploaded documents (relative to the backend folder or absolute)
STORAGE_DIR=storage

# Email notifications (optional). Leave SMTP_HOST empty to keep email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# WhatsApp Business Cloud API version used for replies (per-workspace credentials are entered in the app)
WHATSAPP_GRAPH_VERSION=v21.0

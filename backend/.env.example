# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. See DECISIONS.md D003 for provisioning options.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tangent_smart_manager?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed origins for the Flutter web client.
CORS_ORIGIN=http://localhost:5173
